.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
# node state — never committed
*.jsonl.lock
heartbeat.json
runs.jsonl
tasks.jsonl
schedules.jsonl
recurring.jsonl
PRIME.md
.DS_Store
pull-audit.log

# Procedures are CONTENT, not runtime. An operator's ASOPs describe their
# companies, their rituals and their incidents, so they live in that operator's
# own private repo — never here. Generic example procedures may ship with the
# runtime one day; when they do they will be written for that purpose, not
# lifted from somebody's deployment.
procedures/

# leakguard denylist — a list of real names is itself a list of real names.
# Local only; CI runs base rules, or supplies its own via --config.
tools/leakguard/leakguard.toml

# Work-front coordination state: which agents are live, vendor usage limits,
# machine permissions, vault paths. Operational detail about ONE deployment,
# which is not what a public runtime repo is for. Stays on disk so the agents
# working this tree still read it; just not published.
ai-tasks/

# Grader artifacts: swebench run_evaluation writes logs/ relative to cwd.
# Run output, not source, and it carries third-party test output.
logs/
*.goldcheck.json
*.nullcheck.json
*.asop-eval.json
